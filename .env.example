##############################################################################
#  JAI FANCY PACKS -- Root .env
#  Loaded by Django (backend) and Next.js (frontend).
#  Fill in the secret values before running.
#  NEVER commit the real .env to version control!
##############################################################################


# -- Django Core --------------------------------------------------------------
# Generate a secret key:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-to-a-long-random-secret-key
DJANGO_DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1


# -- Database -----------------------------------------------------------------
# PostgreSQL: DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DB_NAME
# SQLite (default -- no external server needed):
DATABASE_URL=sqlite:///db.sqlite3


# -- CORS / CSRF --------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000


# -- URLs ---------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://127.0.0.1:8000


# -- Email (Resend SMTP) ------------------------------------------------------
# Dev: prints emails to terminal; Prod: change to smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=resend
# Your Resend API key (starts with "re_")
EMAIL_HOST_PASSWORD=
ORDER_FROM_EMAIL=Jai Fancy Packs Orders <orders@jaifancypacks.com>
NOREPLY_FROM_EMAIL=Jai Fancy Packs <noreply@jaifancypacks.com>
# Admin notification email (optional)
ADMINS_EMAIL=


# -- Razorpay -----------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXX
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
# Set to 1 to skip real Razorpay calls in local dev (DJANGO_DEBUG must also be 1)
RAZORPAY_SKIP=0


# -- Media Storage ------------------------------------------------------------
# Set exactly ONE of these to 1; leave both 0 to use local disk storage.
USE_CLOUDINARY=1
USE_S3=0

# Cloudinary (requires USE_CLOUDINARY=1)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AWS S3 (requires USE_S3=1)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1


# -- Shipping -----------------------------------------------------------------
# Flat doorstep delivery fee in INR (0 = free)
DOORSTEP_SHIPPING_INR=0
STORE_PICKUP_LINE1=Jai Fancy Packs, 481/2, Tiru nager 1st Street, Selvapuram
STORE_PICKUP_LINE2=via Ukkadam byepasss road, via sundakamuttur byepass road
STORE_PICKUP_CITY=Coimbatore
STORE_PICKUP_STATE=Tamil Nadu
STORE_PICKUP_POSTAL_CODE=641026
STORE_PICKUP_MAP_URL=https://www.google.com/maps/search/?api=1&query=Jai+Fancy+Packs%2C+481%2F2%2C+Tiru+nager+1st+Street%2C+Selvapuram%2C+Coimbatore%2C+Tamil+Nadu+641026


# -- Django Security (production hardening) -----------------------------------
# Leave DJANGO_SECURE=0 for local dev. Auto-enabled when DJANGO_DEBUG=0.
DJANGO_SECURE=0
DJANGO_USE_X_FORWARDED_PROTO=1
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_SESSION_COOKIE_SAMESITE=Lax
DJANGO_CSRF_COOKIE_SAMESITE=Lax
DJANGO_X_FRAME_OPTIONS=DENY
DJANGO_SECURE_REFERRER_POLICY=same-origin
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=1
DJANGO_SECURE_HSTS_PRELOAD=0


# -- Next.js / Frontend -------------------------------------------------------
# Option A - Direct (local dev, CORS must be open):
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# Option B - Proxied via Next.js rewrites (no CORS needed):
#   NEXT_PUBLIC_API_URL=/api-backend
#   BACKEND_PROXY_TARGET=http://127.0.0.1:8000

# Next.js server-side proxy target (see next.config.ts rewrites)
BACKEND_PROXY_TARGET=http://127.0.0.1:8000

# Canonical frontend URL (used in SEO / OG tags / structured data)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000

# Cloudinary cloud name for the CloudImage component (public, read-only)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Razorpay publishable key -- safe to expose to the browser
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXX
