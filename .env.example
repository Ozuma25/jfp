# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (Render PostgreSQL example)
DATABASE_URL=postgresql://<user>:<password>@<render-host>/<database>

# SQLite without editing this file: copy backend/.env.example → backend/.env and set DATABASE_URL=sqlite:///db.sqlite3

# If you see "password authentication failed for user jfp" on 5432, either:
# - Another Postgres is on 5432: use the URL above + `docker compose up -d db`, or
# - Reset the Docker DB (deletes data): `docker compose down -v && docker compose up -d db`
# - Or unset DATABASE_URL / use backend/.env SQLite so Django uses backend/db.sqlite3

# After migrate: cd backend && .venv/bin/python manage.py seed_catalog

# CORS (Next.js default dev server)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Next.js (copy to frontend/.env.local)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Redis / Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Media: local in dev, S3 in prod
USE_S3=0
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1

# Email (dev: console backend if empty)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=orders@jaifancypacks.com

# SMS / WhatsApp (optional; disabled if empty)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Razorpay (optional for dev; use test keys). NEXT_PUBLIC_RAZORPAY_KEY_ID can mirror RAZORPAY_KEY_ID for Checkout.js.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# With DJANGO_DEBUG=1, set to 1 to skip Razorpay and mark checkout as paid (local only).
RAZORPAY_SKIP=0
