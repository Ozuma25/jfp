# Copy to `.env` in this folder for local overrides (see config/settings/base.py).
# Use your Render PostgreSQL URL:
# DATABASE_URL=postgresql://<user>:<password>@<render-host>/<database>
# Or SQLite when Postgres is unavailable:
# DATABASE_URL=sqlite:///db.sqlite3

# Media storage (optional)
# USE_CLOUDINARY=1
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
